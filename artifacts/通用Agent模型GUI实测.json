    "summary": "合并 source1 与 source2 到目标 HR 模板：统一字段名，清除姓名两端空白，去除手机号中的连字符和空格，入职日期统一转为 YYYYMMDD，剔除金额小于 0 的行，按工号去重（仅完全一致记录去重，冲突保留待人工），地址拆分为省市区。工号保持文本以保留前导零。异常值（非法手机号、无法解析日期、缺失行政区划、金额非法）保留并标记异常，交由类型校验与人工决策，不做猜测。",
    "code": "rows1 = table(\"source1\")\nrows2 = table(\"source2\")\nrows1 = map_fields(rows1, {\"Emp_ID\":\"员工编号\", \"Emp_Name\":\"员工姓名\", \"JoinDate\":\"入职日期\", \"Mobile\":\"联系电话\", \"Amount\":\"报销金额\", \"Address\":\"家庭地址\"})\nrows2 = map_fields(rows2, {\"Emp_ID\":\"person_code\", \"Emp_Name\":\"full_name\", \"JoinDate\":\"hired_on\", \"Mobile\":\"mobile\", \"Amount\":\"claim_total\", \"Address\":\"home_address\"})\nrows = merge([rows1, rows2])\nrows = trim(rows, [\"Emp_ID\", \"Emp_Name\", \"Mobile\", \"Amount\", \"JoinDate\", \"Address\"])\nrows = replace_text(rows, \"Mobile\", {\"-\":\"\", \" \":\"\"})\nrows = cast(rows, \"JoinDate\", \"date\", format=\"%Y%m%d\")\nrows = cast(rows, \"Amount\", \"decimal\")\nrows = filter_rows(rows, \"Amount\", \"ge\", 0, True)\nrows = dedupe(rows, [\"Emp_ID\"])\nrows = split_address(rows, \"Address\", \"Province\", \"City\", \"District\")\nresult = select_columns(rows, [\"Emp_ID\", \"Emp_Name\", \"JoinDate\", \"Mobile\", \"Amount\", \"Province\", \"City\", \"District\"])",
